    "html-minifier-terser": "^7.2.0",
    "html-validate": "^11.19.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.1",
    "terser": "^5.51.2",
    "vite": "^8.3.6",
    "vite-plugin-compression2": "^2.5.4"
  }
}
