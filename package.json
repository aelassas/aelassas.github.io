    "ncu": "npm-check-updates -u",
    "size": "ls -lh dist/assets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
